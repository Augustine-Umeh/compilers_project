/*
 * 4.cm - Three targeted semantic errors
 * 1) Returning a value from a void function
 * 2) Void expression used as if-condition
 * 3) Wrong argument type in function call
 */

int takesInt(int x) {
  return x;
}

void bad(void) {
  return 1;
}

void main(void) {
  if (output(1)) {
    output(0);
  }
  output(bad());
  return;
}
