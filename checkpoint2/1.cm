/*
 * 1.cm - Valid semantic baseline
 * Expected semantic result: no errors.
 * Coverage: globals, arrays, function calls, nested block scope.
 */

int g;
int nums[5];

int add(int a, int b) {
  int tmp;
  tmp = a + b;
  return tmp;
}

void fill(int base) {
  int i;
  i = 0;
  while (i < 5) {
    nums[i] = base + i;
    i = i + 1;
  }
  return;
}

void main(void) {
  int x;
  int y;
  x = input();
  fill(x);
  y = add(nums[0], true);
  if (y > 0) {
    int inner;
    inner = y;
    output(inner);
  } else {
    output(0);
  }
  return;
}
