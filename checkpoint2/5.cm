/*
 * 5.cm - Semantic stress test
 * Expected: many semantic errors across scope, indexing, assignments,
 * conditions, calls, and returns.
 */

int good(int x, int y) {
  return x + y;
}

void noop(void) {
  return;
}

void takesInt(int x) {
  return;
}

void main(void) {
  int a;
  int a;
  int arr[3];

  a = unknown;
  arr[output(1)] = 2;
  a = noop();
  a = noop() + 1;

  if (noop()) {
    a = 1;
  }

  while (noop()) {
    a = a + 1;
  }

  takesInt(noop());
  good(1);
  output(arr);
  arr = 4;
  return noop();
}
