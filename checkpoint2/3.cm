/*
 * 3.cm - Three targeted semantic errors
 * 1) Redefinition in same scope
 * 2) Array index expression is bool (not int)
 * 3) Wrong argument count in function call
 */

int sum2(int a, int b) {
  return a + b;
}

void main(void) {
  int a;
  int a;
  int arr[4];
  int i;
  i = 1;
  arr[i < 2] = 7;
  output(sum2(1));
  return;
}
