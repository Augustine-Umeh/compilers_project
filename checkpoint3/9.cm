/*
 * 9.cm - Valid mutual recursion stress test
 * Exercises prototypes, mutual recursion, multiple outputs, and non-trivial call flow.
 * Expected runtime output: 1 then 0
 */

int even(int n);
int odd(int n);

int even(int n) {
  if (n == 0) {
    return 1;
  } else {
    return odd(n - 1);
  }
}

int odd(int n) {
  if (n == 0) {
    return 0;
  } else {
    return even(n - 1);
  }
}

void main(void) {
  output(even(6));
  output(odd(6));
}
